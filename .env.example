# Public site URL (used for metadata / Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://[PLACEHOLDER_DOMAIN]

# Resend email delivery (https://resend.com)
RESEND_API_KEY=[PLACEHOLDER_RESEND_API_KEY]

# Where lead notifications are delivered (your clinic inbox)
LEAD_TO_EMAIL=[PLACEHOLDER_CLINIC_INBOX_EMAIL]

# Verified sender address in Resend (e.g. "Dermolyxa <leads@yourdomain.com>")
LEAD_FROM_EMAIL="Dermolyxa <[PLACEHOLDER_VERIFIED_SENDER]>"
